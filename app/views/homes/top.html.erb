<%= render "layouts/header" %>

<!-- メインビジュアル -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">
      <div class="bg-warning-subtle rounded-4 p-3 p-lg-5 text-center">
        <h1 class="display-6 display-lg-5 fw-bold mb-3 mb-lg-4">
          毎日の離乳食を、もっと楽しく。
        </h1>
        <p class="fs-6 fs-lg-5 mb-4">
          mogumoは、離乳食のレシピを共有して、
          子育て中のユーザー同士で交流できるサイトです。
        </p>
        <div class="d-flex flex-column flex-lg-row justify-content-center align-items-center gap-3 gap-lg-0">
          <%= link_to public_posts_path,
                      class: "btn btn-success rounded-pill px-5 w-100",
                      style: "max-width: 280px;" do %>
            レシピを探す
            <i class="bi bi-search ms-2"></i>
          <% end %>

          <%= link_to public_groups_path,
                      class: "btn btn-outline-success rounded-pill px-5 w-100 ms-lg-2",
                      style: "max-width: 280px;" do %>
            コミュニティーを見る
            <i class="bi bi-people ms-2"></i>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- mogumoについて -->
<div class="container py-5">
  <div class="text-center mb-3 mb-md-5">
    <h2 class="fw-bold mogumo-heading">
      <span class="small text-secondary">・・・・</span>
      mogumoでできること
      <span class="small text-secondary">・・・・</span>
    </h2>
  </div>

  <div class="row row-cols-1 row-cols-md-3 g-4">
    <!-- レシピを探す -->
    <div class="col">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body text-center p-3 p-md-4">
          <div class="mb-3">
            <i class="bi bi-search fs-1 text-success"></i>
          </div>
          <h3 class="h5 fw-bold mb-3">
            レシピを探す
          </h3>
          <p class="text-secondary small lh-lg mb-0">
            みんなが投稿した離乳食レシピから、
            気になるレシピを探すことができます。
          </p>
        </div>
      </div>
    </div>

    <!-- レシピを投稿 -->
    <div class="col">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body text-center p-3 p-md-4">
          <div class="mb-3">
            <i class="bi bi-journal-plus fs-1 text-success"></i>
          </div>
          <h3 class="h5 fw-bold mb-3">
            レシピを投稿
          </h3>
          <p class="text-secondary small lh-lg mb-0">
            自分が作った離乳食レシピを投稿して、
            他のユーザーと共有できます。
          </p>
        </div>
      </div>
    </div>

    <!-- コミュニティー -->
    <div class="col">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body text-center p-3 p-md-4">
          <div class="mb-3">
            <i class="bi bi-people fs-1 text-success"></i>
          </div>
          <h3 class="h5 fw-bold mb-3">
            コミュニティー
          </h3>
          <p class="text-secondary small lh-lg mb-0">
            同じテーマに興味を持つユーザーと
            情報交換することができます。
          </p>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- 新着レシピ -->
<div class="container py-5">
  <div class="d-flex justify-content-center align-items-center position-relative mb-4">
    <h2 class="fw-bold mogumo-heading">
      <span class="small text-secondary">・・・・</span>
      新着レシピ
      <span class="small text-secondary">・・・・</span>
    </h2>

    <!-- PC表示時のみ右側に表示 -->
    <%= link_to public_posts_path,
                class: "btn btn-outline-success btn-sm rounded-pill position-absolute end-0 px-4 d-none d-md-inline-block" do %>
      もっと見る
      <i class="bi bi-chevron-right ms-2"></i>
    <% end %>
  </div>

  <% if defined?(@posts) && @posts.present? %>
    <div class="row row-cols-2 row-cols-lg-4 g-3 g-lg-4">
      <% @posts.first(4).each do |post| %>
        <div class="col">
          <%= link_to public_post_path(post),
                      class: "text-decoration-none text-dark" do %>
            <div class="card border-0 rounded-4 overflow-hidden h-100 shadow-sm recipe-card">

              <!-- 画像 -->
              <div class="ratio ratio-4x3 bg-secondary-subtle">
                <% if post.image.attached? %>
                  <%= image_tag post.image,
                                class: "w-100 h-100 object-fit-cover" %>
                <% end %>
              </div>

              <!-- 投稿情報 -->
              <div class="card-body bg-warning-subtle recipe-card-body">
                <!-- 公開状態 -->
                <% if post.visibility == "public" %>
                  <div class="mb-2">
                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill recipe-badge">
                      全体公開
                    </span>
                  </div>
                <% end %>

                <!-- ユーザー名 -->
                <p class="small fw-bold text-secondary mb-2 recipe-user-name">
                  <%= post.user.name %>
                </p>

                <!-- タイトル -->
                <h5 class="fw-bold mb-3 recipe-title">
                  <%= post.title %>
                </h5>

                <!-- 対象年齢 -->
                <% if post.target_age.present? %>
                  <p class="small text-muted mb-2 recipe-age">
                    対象年齢：<%= post.target_age %>
                  </p>
                <% end %>

                <!-- 投稿日 -->
                <p class="small text-secondary mb-0 recipe-date">
                  <%= post.created_at.strftime("%Y/%m/%d") %>
                </p>

              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  <% else %>

    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body text-center py-5">
        <p class="text-secondary mb-0">
          まだレシピが投稿されていません。
        </p>
      </div>
    </div>
  <% end %>

  <div class="text-center mt-4 d-md-none">
    <%= link_to public_posts_path,
                class: "btn btn-outline-success rounded-pill px-5 w-100 ms-lg-2",
                style: "max-width: 280px;" do %>
      もっと見る
      <i class="bi bi-chevron-right ms-2"></i>
    <% end %>
  </div>
</div>

<!-- コミュニティー -->
<div class="container py-5">
  <div class="text-center mb-3 mb-md-5">
    <h2 class="fw-bold mogumo-heading">
      <span class="small text-secondary">・・・・</span>
      コミュニティー
      <span class="small text-secondary">・・・・</span>
    </h2>
    <p class="text-secondary small mt-3">
      気になるコミュニティーに参加して、みんなと交流してみましょう。
    </p>
  </div>

  <div class="text-center">
    <%= link_to public_groups_path,
                class: "btn btn-success rounded-pill px-5" do %>
      コミュニティーを探す
      <i class="bi bi-chevron-right ms-2"></i>
    <% end %>
  </div>
</div>

<!-- About -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center p-4 p-md-5">
          <h2 class="h5 fw-bold mb-3">
            mogumoについて
          </h2>
          <p class="text-secondary small lh-lg mb-4">
            mogumoは、離乳食レシピを通して
            子育て中のユーザー同士が情報交換できる場所です。
          </p>
          <%= link_to "mogumoについて詳しく見る",
                      homes_about_path,
                      class: "btn btn-outline-success rounded-pill px-4" %>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render "layouts/footer" %>
