<!DOCTYPE html>
<html>

  <head>
    <title>mogumo 管理画面</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet">

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js">
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "style", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>

    <div class="min-vh-100">

      <!-- ヘッダー -->
      <header class="bg-dark text-white border-bottom">

        <div
          class="d-flex align-items-center justify-content-between"
          style="height: 70px;">

          <!-- ロゴ -->
          <div style="width: 240px;" class="text-center">

            <%= link_to admin_root_path do %>

              <%= image_tag "mogumo_logo.png",
                            alt: "mogumo",
                            class: "img-fluid",
                            style: "max-width: 160px;" %>

            <% end %>

          </div>

          <!-- 管理者メニュー -->
          <div class="dropdown me-4">

            <button
              class="btn btn-dark dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false">

              <%= Current.admin.name %>

            </button>

            <ul class="dropdown-menu dropdown-menu-end">

              <li>
                <%= link_to "管理者情報編集",
                            edit_admin_admin_path(Current.admin),
                            class: "dropdown-item" %>
              </li>

              <li>
                <hr class="dropdown-divider">
              </li>

              <li>
                <%= button_to "ログアウト",
                            admin_session_path,
                            method: :delete,
                            class: "dropdown-item" %>
              </li>

            </ul>

          </div>

        </div>

      </header>


      <!-- ヘッダー下 -->
      <div class="d-flex">

        <!-- 左ナビゲーション -->
        <nav
          class="bg-dark text-white p-3 min-vh-100"
          style="width: 240px; flex-shrink: 0;">

          <!-- 管理者管理 -->
          <div class="mb-4">

            <div class="text-secondary small mb-2">
              管理者管理
            </div>

            <%= link_to "管理者一覧",
                        admin_admins_path,
                        class: "d-block text-white text-decoration-none py-2 px-3 rounded" %>

          </div>

          <!-- グループ管理 -->
          <div class="mb-4">
                                  
            <div class="text-secondary small mb-2">
              グループ管理
            </div>
                                  
            <%= link_to "グループ一覧",
                        admin_groups_path,
                        class: "d-block text-white text-decoration-none py-2 px-3 rounded" %>
                        
          </div>

          <!-- コメント管理 -->
          <div class="mb-4">

            <div class="text-secondary small mb-2">
              コメント管理
            </div>

            <%= link_to "コメント一覧",
                        admin_comments_path,
                        class: "d-block text-white text-decoration-none py-2 px-3 rounded" %>

          </div>

        </nav>


        <!-- メインコンテンツ -->
        <main class="flex-grow-1 p-4">

          <%= yield %>

        </main>

      </div>

    </div>

  </body>

</html>