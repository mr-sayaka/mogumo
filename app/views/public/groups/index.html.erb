<%= render "layouts/header" %>

<div class="container py-5">

  <!-- タイトル -->

  <div class="d-flex justify-content-center align-items-center mb-5">
    <h2 class="fw-bold mb-0">
      <span class="small text-secondary">・・・・</span>
      コミュニティー
      <span class="small text-secondary">・・・・</span>
    </h2>
  </div>

  <!-- 説明 -->

  <div class="text-center mb-5">
    <p class="text-secondary mb-0">
      気になるコミュニティーを見つけて、みんなと交流してみましょう。
    </p>
  </div>

<% if @groups.any? %>

<!-- コミュニティー一覧 -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">

  <% @groups.each do |group| %>

    <div class="col">

      <div class="card border-0 rounded-4 shadow-sm h-100 overflow-hidden">

        <!-- カード上部 -->
        <div class="bg-warning-subtle p-4">

          <!-- コミュニティー名 -->
          <h3 class="h5 fw-bold mb-0">
            <%= group.name %>
          </h3>

        </div>

        <!-- カード内容 -->
        <div class="card-body d-flex flex-column p-4">

          <!-- 説明 -->
          <% if group.description.present? %>
            <div class="mb-4">

              <p class="small text-secondary mb-0">
                <%= truncate(group.description, length: 100) %>
              </p>

            </div>
          <% end %>

          <!-- テーマ -->
          <% if group.theme.present? %>
            <div class="mb-4">

              <p class="small fw-bold mb-1">
                テーマ
              </p>

              <p class="mb-0">
                <%= group.theme %>
              </p>

            </div>
          <% end %>

          <!-- 参加人数 -->
          <div class="mb-4">

            <p class="small fw-bold mb-1">
              参加者
            </p>

            <p class="mb-0">
              <%= group.members.count %>人
            </p>

          </div>

          <!-- 管理者 -->
          <div class="small text-secondary mb-4">

            管理者：
            <%= group.admin.name %>

          </div>

          <!-- 詳細ボタン -->
          <div class="mt-auto">

            <%= link_to public_group_path(group),
                        class: "btn btn-success rounded-pill w-100" do %>

              コミュニティーを見る

              <i class="bi bi-chevron-right ms-2"></i>

            <% end %>

          </div>

        </div>

      </div>

    </div>

  <% end %>

</div>

<% else %>

<!-- コミュニティーがない場合 -->

<div class="card border-0 shadow-sm rounded-4">

  <div class="card-body text-center py-5">

    <p class="text-secondary mb-0">
      現在コミュニティーはありません。
    </p>

  </div>

</div>

<% end %>

</div>

<%= render "layouts/footer" %>
