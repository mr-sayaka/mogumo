<%= render "layouts/header" %>

<div class="container py-5">

  <!-- コミュニティー名 -->

  <div class="text-center mb-5">


<h1 class="fw-bold mb-3">
  <%= @group.name %>
</h1>

  </div>

  <div class="row justify-content-center">


<div class="col-12 col-lg-9">

  <!-- コミュニティーについて -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body p-4">

      <h2 class="h5 fw-bold border-bottom pb-3 mb-4">
        コミュニティーについて
      </h2>

      <!-- 説明 -->
      <div class="mb-4">

        <h3 class="h6 fw-bold mb-2">
          説明
        </h3>

        <% if @group.description.present? %>

          <p class="mb-0">
            <%= simple_format(@group.description) %>
          </p>

        <% else %>

          <p class="text-secondary mb-0">
            説明はありません。
          </p>

        <% end %>

      </div>


      <!-- テーマ -->
      <div class="mb-4">

        <h3 class="h6 fw-bold mb-2">
          テーマ
        </h3>

        <% if @group.theme.present? %>

          <p class="mb-0">
            <%= simple_format(@group.theme) %>
          </p>

        <% else %>

          <p class="text-secondary mb-0">
            テーマは設定されていません。
          </p>

        <% end %>

      </div>

    </div>

  </div>


  <!-- コミュニティールール -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body p-4">

      <h2 class="h5 fw-bold border-bottom pb-3 mb-4">
        コミュニティールール
      </h2>

      <% if @group.rules.present? %>

        <div>
          <%= simple_format(@group.rules) %>
        </div>

      <% else %>

        <p class="text-secondary mb-0">
          ルールは設定されていません。
        </p>

      <% end %>

    </div>

  </div>


  <!-- 参加者 -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body p-4">

      <h2 class="h5 fw-bold border-bottom pb-3 mb-4">
        参加者
      </h2>

      <p class="fs-4 fw-bold mb-0">
        <%= @group.members.count %>人
      </p>

    </div>

  </div>


  <!-- 参加・退会 -->
  <div class="text-center mt-5 mb-5">

    <% if @membership %>

      <%= button_to "参加中",
                    public_group_membership_path(@group),
                    method: :delete,
                    class: "btn btn-outline-danger rounded-pill px-5",
                    data: {
                      turbo_confirm: "このコミュニティーから退会しますか？"
                    } %>

    <% else %>

      <%= button_to "このコミュニティーに参加する",
                    public_group_membership_path(@group),
                    method: :post,
                    class: "btn btn-success rounded-pill px-5" %>

    <% end %>

  </div>


  <!-- コミュニティー限定レシピ -->
  <div class="mt-5">

    <div class="text-center mb-4">

      <h2 class="fw-bold">
        <span class="small text-secondary">・・・・</span>
        コミュニティー限定レシピ
        <span class="small text-secondary">・・・・</span>
      </h2>

      <p class="text-secondary small mt-3">
        このコミュニティーで共有されているレシピです。
      </p>

    </div>


    <!-- 参加者だけが限定レシピを見る -->
    <% if @membership %>

      <% if @posts.any? %>

        <!-- 3列表示 -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">

          <% @posts.each do |post| %>

            <div class="col">

              <%= link_to public_post_path(post),
                          class: "text-decoration-none text-dark" do %>

                <div class="card border-0 rounded-4 overflow-hidden h-100 shadow-sm">

                  <!-- 画像 -->
                  <div class="ratio ratio-4x3 bg-secondary-subtle">

                    <% if post.image.attached? %>

                      <%= image_tag post.image,
                                    class: "w-100 h-100 object-fit-cover" %>

                    <% end %>

                  </div>


                  <!-- 限定バッジ -->
                  <div class="px-3 pt-3">

                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-3 py-2">
                      <%= @group.name %>限定
                    </span>

                  </div>


                  <!-- 投稿情報 -->
                  <div class="card-body bg-warning-subtle">

                    <!-- ユーザー名 -->
                    <p class="small fw-bold mb-2">
                      <%= post.user.name %>
                    </p>


                    <!-- タイトル -->
                    <h5 class="fw-bold mb-3">
                      <%= post.title %>
                    </h5>


                    <!-- 投稿日 -->
                    <p class="small text-secondary mb-0">
                      <%= post.created_at.strftime("%Y/%m/%d") %>
                    </p>


                    <!-- コメント数 -->
                    <p class="small text-secondary mb-0">
                      <i class="bi bi-chat"></i>
                      <%= post.comments.count %>
                    </p>

                  </div>

                </div>

              <% end %>

            </div>

          <% end %>

        </div>

      <% else %>

        <!-- まだ投稿がない場合 -->
        <div class="card border-0 shadow-sm rounded-4">

          <div class="card-body text-center py-5">

            <p class="text-secondary mb-0">
              まだコミュニティー限定のレシピはありません。
            </p>

          </div>

        </div>

      <% end %>

    <% else %>

      <!-- 未参加の場合 -->
      <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body text-center py-5">

          <p class="fw-bold mb-2">
            コミュニティー限定レシピを見るには、
            コミュニティーへの参加が必要です。
          </p>

          <p class="text-secondary small mb-0">
            参加すると、このコミュニティーで共有されている
            限定レシピを見ることができます。
          </p>

        </div>

      </div>

    <% end %>

  </div>


  <!-- 一覧へ戻る -->
  <div class="text-center mt-5">

    <%= link_to "コミュニティー一覧に戻る",
                public_groups_path,
                class: "btn btn-outline-secondary rounded-pill px-4" %>

  </div>

</div>


  </div>

</div>

<%= render "layouts/footer" %>
