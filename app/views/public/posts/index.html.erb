<%= render "layouts/header" %>

<div class="container py-5">

  <!-- タイトル・投稿ボタン -->

  <div class="d-flex justify-content-center align-items-center position-relative mb-5">

<h2 class="fw-bold mb-0">
  <span class="small text-secondary">・・・・</span>
  新着レシピ
  <span class="small text-secondary">・・・・</span>
</h2>

<%= link_to new_public_post_path,
            class: "btn btn-success btn-sm rounded-pill position-absolute end-0 px-4" do %>
  レシピを投稿する
  <i class="bi bi-chevron-right ms-2"></i>
<% end %>


  </div>

  <!-- 説明 -->

  <div class="text-center mb-5">


<p class="text-secondary mb-0">
  みんなの離乳食レシピを見てみましょう。
</p>


  </div>

  <!-- 投稿一覧 -->

<% if @posts.any? %>


<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">

  <% @posts.each do |post| %>

    <div class="col">

      <%= link_to public_post_path(post),
                  class: "text-decoration-none text-dark" do %>

        <div class="card border-0 rounded-4 overflow-hidden h-100 shadow-sm">

          <!-- 画像 -->
          <div class="ratio ratio-4x3 bg-secondary-subtle">

            <% if post.image.attached? %>

              <%= image_tag post.image,
                            class: "w-100 h-100 object-fit-cover" %>

            <% end %>

          </div>


          <!-- 公開状態 -->
          <div class="px-3 pt-3">

            <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2">
              全体公開
            </span>

          </div>


          <!-- 投稿情報 -->
          <div class="card-body bg-warning-subtle">

            <!-- ユーザー名 -->
            <p class="small fw-bold mb-2">

              <%= post.user.name %>

            </p>


            <!-- タイトル -->
            <h5 class="fw-bold mb-3">

              <%= post.title %>

            </h5>


            <!-- 投稿日・コメント -->
            <div class="d-flex justify-content-between align-items-center">

              <p class="small text-secondary mb-0">

                <%= post.created_at.strftime("%Y/%m/%d") %>

              </p>

              <p class="small text-secondary mb-0">

                <i class="bi bi-chat"></i>
                <%= post.comments.count %>

              </p>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% end %>

</div>


<% else %>

<!-- 投稿がない場合 -->
<div class="card border-0 shadow-sm rounded-4">

  <div class="card-body text-center py-5">

    <p class="text-secondary mb-0">
      まだ公開されているレシピはありません。
    </p>

  </div>

</div>


<% end %>

</div>

<%= render "layouts/footer" %>
