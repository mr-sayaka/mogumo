<%= render "layouts/header" %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <h1 class="text-center mb-4">離乳食を投稿する</h1>

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <%= form_with model: @post,
              url: public_posts_path,
              multipart: true do |f| %>

            <% if @post.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @post.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- 画像 -->
            <div class="mb-4">
              <%= f.label :image, class: "form-label" do %>
                離乳食の画像
                <span class="badge bg-warning text-dark ms-2">必須</span>
              <% end %>

              <%= f.file_field :image,
                    class: "form-control",
                    accept: "image/*" %>
              <div class="form-text">
                離乳食の画像を1枚選択してください。
              </div>
            </div>
            
            <!-- タイトル -->
            <div class="mb-4">
              <%= f.label :title, class: "form-label" do %>
                タイトル
                <span class="badge bg-warning text-dark ms-2">必須</span>
              <% end %>

              <%= f.text_field :title,
                    class: "form-control",
                    placeholder: "例：10ヶ月の息子が喜んだ野菜たっぷり離乳食" %>
            </div>

            <!-- 紹介文 -->
            <div class="mb-4">
              <%= f.label :introduction, class: "form-label" do %>
                紹介文
                <span class="badge bg-warning text-dark ms-2">必須</span>
              <% end %>

              <%= f.text_area :introduction,
                    rows: 4,
                    class: "form-control",
                    placeholder: "この離乳食について紹介してください" %>
            </div>

            <!-- 公開範囲 -->
            <div class="mb-4">
              <%= f.label :visibility, class: "form-label" do %>
                公開範囲
                <span class="badge bg-warning text-dark ms-2">必須</span>
              <% end %>

              <%= f.select :visibility,
                           [
                             ["全体公開", "public"],
                             ["コミュニティー限定", "group"]
                           ],
                           {},
                           class: "form-select" %>
            </div>

            <!-- コミュニティー -->
            <div class="mb-4">
              <%= f.label :group_id, class: "form-label" do %>
                コミュニティー
                <span class="badge bg-info text-dark ms-2">条件付き必須</span>
              <% end %>

              <%= f.collection_select :group_id,
                                      @joined_groups,
                                      :id,
                                      :name,
                                      { include_blank: "コミュニティーを選択してください" },
                                      { class: "form-select" } %>

              <div class="form-text">
                ※ 公開範囲で「コミュニティー限定」を選択した場合は、
                コミュニティーの選択が必要です。
              </div>
            </div>

            <!-- 対象年齢 -->
            <div class="mb-4">
              <%= f.label :target_age, class: "form-label" do %>
                対象年齢
                <span class="badge bg-warning text-dark ms-2">必須</span>
              <% end %>

              <%= f.select :target_age,
                           [
                             ["対象年齢を選択してください", ""],
                             ["5〜6ヶ月", "5〜6ヶ月"],
                             ["7〜8ヶ月", "7〜8ヶ月"],
                             ["9〜11ヶ月", "9〜11ヶ月"],
                             ["1歳〜", "1歳〜"]
                           ],
                           {},
                           class: "form-select" %>
            </div>

            <!-- 材料 -->
            <div class="mb-4">
              <%= f.label :ingredients, class: "form-label" do %>
                材料
                <span class="badge bg-warning text-dark ms-2">必須</span>
              <% end %>

              <%= f.text_area :ingredients,
                    rows: 6,
                    class: "form-control",
                    placeholder: "例：・にんじん 30g・かぼちゃ 30g・豆腐 20g" %>
            </div>

            <!-- 作り方 -->
            <div class="mb-4">
              <%= f.label :how_to_make, class: "form-label" do %>
                作り方
                <span class="badge bg-warning text-dark ms-2">必須</span>
              <% end %>

              <%= f.text_area :how_to_make,
                    rows: 8,
                    class: "form-control",
                    placeholder: "作り方を順番に入力してください" %>
            </div>

            <!-- アレルギー -->
            <div class="mb-4">
              <%= f.label :allergy, "アレルギー情報", class: "form-label" %>
              <%= f.text_area :allergy,
                    rows: 3,
                    class: "form-control",
                    placeholder: "例：大豆を使用しています" %>
            </div>

            <!-- 投稿ボタン -->
            <div class="text-center">
              <%= f.submit "投稿する",
                  class: "btn btn-success px-5 rounded-pill" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="text-center mt-3">
        <%= link_to "投稿詳細に戻る", public_posts_path, 
            class: "btn btn-outline-secondary btn-sm px-3 rounded-pill" %>
      </div>
    </div>
  </div>
</div>

<%= render "layouts/footer" %>