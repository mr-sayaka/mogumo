<%= render "layouts/header" %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <h1 class="text-center mb-4">離乳食を投稿する</h1>

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <%= form_with model: @post,
              url: public_posts_path,
              multipart: true do |f| %>

            <% if @post.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @post.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- 画像 -->
            <div class="mb-4">
              <%= f.label :image, "離乳食の画像", class: "form-label" %>
              <%= f.file_field :image,
                    class: "form-control",
                    accept: "image/*" %>
              <div class="form-text">
                離乳食の画像を1枚選択してください。
              </div>
            </div>
            
            <!-- タイトル -->
            <div class="mb-4">
              <%= f.label :title, "タイトル", class: "form-label" %>
              <%= f.text_field :title,
                    class: "form-control",
                    placeholder: "例：10ヶ月の息子が喜んだ野菜たっぷり離乳食" %>
            </div>

            <!-- 紹介文 -->
            <div class="mb-4">
              <%= f.label :introduction, "紹介文", class: "form-label" %>
              <%= f.text_area :introduction,
                    rows: 4,
                    class: "form-control",
                    placeholder: "この離乳食について紹介してください" %>
            </div>

            <!-- 対象年齢 -->
            <div class="mb-4">
              <%= f.label :target_age, "対象年齢", class: "form-label" %>
              <%= f.text_field :target_age,
                    class: "form-control",
                    placeholder: "例：9〜11ヶ月" %>
            </div>

            <!-- 材料 -->
            <div class="mb-4">
              <%= f.label :ingredients, "材料", class: "form-label" %>
              <%= f.text_area :ingredients,
                    rows: 6,
                    class: "form-control",
                    placeholder: "例：・にんじん 30g・かぼちゃ 30g・豆腐 20g" %>
            </div>

            <!-- 作り方 -->
            <div class="mb-4">
              <%= f.label :how_to_make, "作り方", class: "form-label" %>
              <%= f.text_area :how_to_make,
                    rows: 8,
                    class: "form-control",
                    placeholder: "作り方を順番に入力してください" %>
            </div>

            <!-- アレルギー -->
            <div class="mb-4">
              <%= f.label :allergy, "アレルギー情報", class: "form-label" %>
              <%= f.text_area :allergy,
                    rows: 3,
                    class: "form-control",
                    placeholder: "例：大豆を使用しています" %>
            </div>

            <!-- 投稿ボタン -->
            <div class="d-grid">
              <%= f.submit "投稿する", class: "btn btn-primary" %>
            </div>

          <% end %>

        </div>
      </div>

      <div class="text-center mt-3">
        <%= link_to "戻る", root_path, class: "text-decoration-none" %>
      </div>

    </div>
  </div>
</div>

<%= render "layouts/footer" %>