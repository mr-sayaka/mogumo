<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">管理者詳細</h1>

    <%= link_to "管理者一覧に戻る",
                admin_admins_path,
                class: "btn btn-outline-secondary" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">

      <dl class="row mb-0">

        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">
          <%= @admin.id %>
        </dd>

        <dt class="col-sm-3">名前</dt>
        <dd class="col-sm-9">
          <%= @admin.name %>
        </dd>

        <dt class="col-sm-3">メールアドレス</dt>
        <dd class="col-sm-9">
          <%= @admin.email_address %>
        </dd>

        <dt class="col-sm-3">登録日時</dt>
        <dd class="col-sm-9">
          <%= l @admin.created_at, format: :long %>
        </dd>

        <dt class="col-sm-3">更新日時</dt>
        <dd class="col-sm-9">
          <%= l @admin.updated_at, format: :long %>
        </dd>

      </dl>

    </div>
  </div>

  <div class="mt-4 d-flex gap-2">

    <%= link_to "編集",
                edit_admin_admin_path(@admin),
                class: "btn btn-primary" %>

    <%= link_to "管理者一覧",
                admin_admins_path,
                class: "btn btn-outline-secondary" %>

  </div>

</div>