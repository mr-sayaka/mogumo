<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">管理者編集</h1>

    <%= link_to "管理者詳細に戻る",
                admin_admin_path(@admin),
                class: "btn btn-outline-secondary" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">

      <%= form_with model: [:admin, @admin], local: true do |f| %>

        <% if @admin.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @admin.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, "名前", class: "form-label" %>
          <%= f.text_field :name,
                           class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :email_address, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email_address,
                            class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "新しいパスワード", class: "form-label" %>
          <%= f.password_field :password,
                               class: "form-control" %>
          <div class="form-text">
            パスワードを変更しない場合は空欄にしてください。
          </div>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
          <%= f.password_field :password_confirmation,
                               class: "form-control" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "更新する",
                       class: "btn btn-primary" %>

          <%= link_to "キャンセル",
                      admin_admin_path(@admin),
                      class: "btn btn-outline-secondary" %>
        </div>

      <% end %>

    </div>
  </div>

</div>