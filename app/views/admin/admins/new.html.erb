<div class="container py-5">

  <div class="mb-4">
    <h1 class="h3">新規管理者登録</h1>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">

      <%= form_with model: @admin,
                    url: admin_admins_path,
                    local: true do |f| %>

        <% if @admin.errors.any? %>
          <div class="alert alert-danger">
            <h5>入力内容を確認してください</h5>
            <ul class="mb-0">
              <% @admin.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, "名前", class: "form-label" %>
          <%= f.text_field :name,
                           class: "form-control",
                           required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :email_address, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email_address,
                            class: "form-control",
                            required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password,
                               class: "form-control",
                               required: true %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation,
                      "パスワード確認",
                      class: "form-label" %>

          <%= f.password_field :password_confirmation,
                               class: "form-control",
                               required: true %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "登録する",
                       class: "btn btn-primary" %>

          <%= link_to "管理者一覧に戻る",
                      admin_admins_path,
                      class: "btn btn-outline-secondary" %>
        </div>

      <% end %>

    </div>
  </div>

</div>