<h1 class="h3 mb-4">コミュニティーを作成</h1>

<div class="card shadow-sm">
  <div class="card-body">

    <% if @group.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @group.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @group,
                  url: admin_groups_path do |f| %>

      <!-- コミュニティー名 -->
      <div class="mb-3">
        <%= f.label :name, "コミュニティー名", class: "form-label" %>

        <%= f.text_field :name,
                         class: "form-control",
                         placeholder: "例：1歳児の離乳食を共有しよう" %>
      </div>

      <!-- コミュニティー説明 -->
      <div class="mb-3">
        <%= f.label :description, "コミュニティー説明", class: "form-label" %>

        <%= f.text_area :description,
                        class: "form-control",
                        rows: 4,
                        placeholder: "コミュニティーの目的や雰囲気を入力してください" %>
      </div>

      <!-- テーマ -->
      <div class="mb-3">
        <%= f.label :theme, "テーマ", class: "form-label" %>

        <%= f.text_field :theme,
                         class: "form-control",
                         placeholder: "例：1歳児向け離乳食" %>
      </div>

      <!-- ルール -->
      <div class="mb-4">
        <%= f.label :rules, "コミュニティールール", class: "form-label" %>

        <%= f.text_area :rules,
                        class: "form-control",
                        rows: 5,
                        placeholder: "例：誹謗中傷は禁止です。" %>
      </div>

      <!-- ボタン -->
      <div class="d-flex gap-2">

        <%= f.submit "コミュニティーを作成",
                     class: "btn btn-primary px-4" %>

        <%= link_to "キャンセル",
                    admin_groups_path,
                    class: "btn btn-outline-secondary px-4" %>

      </div>

    <% end %>

  </div>
</div>