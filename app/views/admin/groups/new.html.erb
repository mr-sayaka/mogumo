<h1 class="h3 mb-4">コミュニティを作成</h1>

<div class="card shadow-sm">
  <div class="card-body">

    <% if @group.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @group.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @group, url: admin_groups_path do |f| %>

      <!-- コミュニティ名 -->
      <div class="mb-3">
        <%= f.label :name, "コミュニティ名", class: "form-label" %>
        <span class="badge bg-warning text-dark">必須</span>

        <%= f.text_field :name,
                         class: "form-control",
                         placeholder: "例：1歳児の離乳食を共有しよう" %>
      </div>

      <!-- コミュニティ説明 -->
      <div class="mb-3">
        <%= f.label :description, "コミュニティ説明", class: "form-label" %>
        <span class="badge bg-warning text-dark">必須</span>

        <%= f.text_area :description,
                        class: "form-control",
                        rows: 4,
                        placeholder: "コミュニティの目的や雰囲気を入力してください" %>
      </div>

      <!-- テーマ -->
      <div class="mb-3">
        <%= f.label :theme, "テーマ", class: "form-label" %>
        <span class="badge bg-warning text-dark">必須</span>

        <%= f.text_field :theme,
                         class: "form-control",
                         placeholder: "例：1歳児向け離乳食" %>
      </div>

      <!-- コミュニティルール -->
      <div class="mb-4">
        <%= f.label :rules, "コミュニティルール", class: "form-label" %>
        <span class="badge bg-warning text-dark">必須</span>

        <%= f.text_area :rules,
                        class: "form-control",
                        rows: 5,
                        placeholder: "例：誹謗中傷は禁止です。" %>
      </div>

      <!-- ボタン -->
      <div class="d-flex gap-2">
        <%= f.submit "コミュニティを作成", class: "btn btn-primary px-4" %>
        <%= link_to "キャンセル", admin_groups_path, class: "btn btn-outline-secondary px-4" %>
      </div>

    <% end %>

  </div>
</div>