<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="h3 mb-0">グループ詳細</h1>

    <div class="d-flex gap-2">

      <%= link_to "編集",
                  edit_admin_group_path(@group),
                  class: "btn btn-outline-primary" %>

      <%= button_to "削除",
                    admin_group_path(@group),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    data: {
                      turbo_confirm: "このグループを削除しますか？"
                    } %>

    </div>

  </div>

  <div class="card shadow-sm">

    <div class="card-body">

      <!-- グループ名 -->
      <div class="mb-4">

        <h2 class="h5">
          グループ名
        </h2>

        <p class="mb-0">
          <%= @group.name %>
        </p>

      </div>

      <!-- グループ説明 -->
      <div class="mb-4">

        <h2 class="h5">
          グループ説明
        </h2>

        <p class="mb-0">
          <%= simple_format(@group.description) %>
        </p>

      </div>

      <!-- テーマ -->
      <div class="mb-4">

        <h2 class="h5">
          テーマ
        </h2>

        <p class="mb-0">
          <%= simple_format(@group.theme) %>
        </p>

      </div>

      <!-- ルール -->
      <div class="mb-4">

        <h2 class="h5">
          グループルール
        </h2>

        <p class="mb-0">
          <%= simple_format(@group.rules) %>
        </p>

      </div>

      <!-- 参加者数 -->
      <div class="mb-4">

        <h2 class="h5">
          参加者数
        </h2>

        <p class="mb-0">
          <%= @group.members.count %>人
        </p>

      </div>

      <%= link_to "グループ一覧へ",
                  admin_groups_path,
                  class: "btn btn-outline-secondary" %>

    </div>

  </div>

</div>