<h1 class="h3 mb-4">グループを編集</h1>

<div class="card shadow-sm">

  <div class="card-body">

    <%= form_with model: @group,
                  url: admin_group_path(@group),
                  method: :patch do |f| %>

      <!-- グループ名 -->
      <div class="mb-3">

        <%= f.label :name,
                    "グループ名",
                    class: "form-label" %>

        <%= f.text_field :name,
                         class: "form-control",
                         placeholder: "例：1歳児の離乳食を共有しよう" %>

      </div>

      <!-- グループ説明 -->
      <div class="mb-3">

        <%= f.label :description,
                    "グループ説明",
                    class: "form-label" %>

        <%= f.text_area :description,
                        class: "form-control",
                        rows: 4,
                        placeholder: "グループの目的や雰囲気を入力してください" %>

      </div>

      <!-- テーマ -->
      <div class="mb-3">

        <%= f.label :theme,
                    "テーマ",
                    class: "form-label" %>

        <%= f.text_field :theme,
                         class: "form-control",
                         placeholder: "例：1歳児向け離乳食" %>

      </div>

      <!-- ルール -->
      <div class="mb-4">

        <%= f.label :rules,
                    "グループルール",
                    class: "form-label" %>

        <%= f.text_area :rules,
                        class: "form-control",
                        rows: 5,
                        placeholder: "例：誹謗中傷は禁止です。" %>

      </div>

      <div class="d-flex gap-2">

        <%= f.submit "変更を保存",
                     class: "btn btn-primary px-4" %>

        <%= link_to "キャンセル",
                    admin_group_path(@group),
                    class: "btn btn-outline-secondary px-4" %>

      </div>

    <% end %>

  </div>

</div>