<h1 class="h3 mb-4">管理者ダッシュボード</h1>

<div class="row g-4">

  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h5">管理者数</h2>
        <p class="display-6 mb-0">
          <%= @admin_count %>人
        </p>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h5">コメント数</h2>
        <p class="display-6 mb-0">
          <%= @comment_count %>件
        </p>
      </div>
    </div>
  </div>

</div>