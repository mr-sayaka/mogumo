<h1 class="h3 mb-4">コメント一覧</h1>

<div class="card shadow-sm">
  <div class="card-body">

    <% if @comments.any? %>

      <div class="table-responsive">
        <table class="table table-hover align-middle" style="table-layout: fixed; width: 100%;">
          <thead>
            <tr>
              <th style="width: 60%;">コメント</th>
              <th style="width: 8%;">投稿者</th>
              <th style="width: 12%;">投稿</th>
              <th style="width: 12%;">投稿日</th>
              <th style="width: 8%;"></th>
            </tr>
          </thead>

          <tbody>
            <% @comments.each do |comment| %>
              <tr>
                <!-- コメント -->
                <td>
                  <%= link_to truncate(comment.body, length: 120), public_post_path(comment.post), class: "admin-comment-link text-break" %>
                </td>

                <!-- コメントしたユーザー -->
                <td class="text-break">
                  <%= comment.user&.name || "退会したユーザー" %>
                </td>

                <!-- コメントされた投稿 -->
                <td class="text-break">
                  <%= link_to truncate(comment.post.title, length: 20), public_post_path(comment.post), class: "admin-comment-link" %>
                </td>

                <!-- 投稿日時 -->
                <td class="text-nowrap">
                  <%= comment.created_at.strftime("%Y/%m/%d %H:%M") %>
                </td>

                <!-- 削除 -->
                <td>
                  <%= button_to "削除",
                                admin_comment_path(comment),
                                method: :delete,
                                data: {
                                  turbo_confirm: "このコメントを削除しますか？"
                                },
                                class: "btn btn-sm btn-outline-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% else %>

      <p class="text-muted mb-0">
        コメントはありません。
      </p>

    <% end %>

  </div>
</div>